# MySQL connection (shared instance with Chartbrew)
DB_HOST=db
DB_PORT=3306
DB_USER=chartbrew
DB_PASSWORD=
DB_NAME=booking_agent

# Server
BOOKING_PORT=3001
BOOKING_PUBLIC_HOSTNAME=your-vps-ip-or-domain.com

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# OpenAI
BOOKING_OPENAI_API_KEY=
BOOKING_OPENAI_MODEL=gpt-4o-mini

# API key to protect the /appointments endpoint (leave empty to disable auth)
BOOKING_API_KEY=

# Business configuration
BUSINESS_NAME=Mein Salon
BUSINESS_HOURS=Mo-Fr 9-18 Uhr
BUSINESS_SERVICES=Haarschnitt,Faerben,Bart trimmen
